# Ancient Greek reconstructed pronunciation — XPF
#
# Based on the supplied SGPNTG reconstruction table and the current pytest
# verification cases. Input is expected to be normalized to Unicode NFC.
#
# Output conventions:
#   long vowels use IPA ː
#   acute and circumflex both become ˈ immediately before the accented
#   vowel or diphthong nucleus; this file does not perform syllabification
#   or move accent markers to syllable onsets
#   grave accent is ignored
#   rough and smooth breathing are phonologically null
#
# XPF sub rules operate on individual graphemes. Digraphs therefore use
# contextual rules on the first grapheme and cleanup rules on the second,
# following the structure of the Modern Greek XPF grammar.
#
# οι is represented as long /yː/, following the supplied reconstruction
# table and the updated verification cases.

type,sfrom,sto,weight,precede,follow,comment

# ----------------------------------------------------------------------
# Classes
# ----------------------------------------------------------------------
class,front,[ιίυύηῆεέήῃ],,,,
class,voiced,[βγδζλμνρ],,,,
class,voiceless,[πκτφθχξψσς],,,,
class,velar,[γκχξ],,,,
class,nasal,[μνγ],,,,
class,sigma,[σς],,,,

# Basic grapheme classes
class,a,[α],,,,
class,e,[ε],,,,
class,eː,[η],,,,
class,i,[ι],,,,
class,y,[υ],,,,
class,o,[ο],,,,
class,oː,[ω],,,,

# Consonants
class,beta,[β],,,,
class,delta,[δ],,,,
class,chi,[χ],,,,
class,phi,[φ],,,,
class,theta,[θ],,,,
class,kappa,[κ],,,,
class,pi,[π],,,,
class,tau,[τ],,,,
class,mu,[μ],,,,
class,nu,[ν],,,,
class,lambda,[λ],,,,
class,rho,[ρ],,,,
class,zeta,[ζ],,,,
class,psi,[ψ],,,,
class,xi,[ξ],,,,
class,gamma,[γ],,,,

# ----------------------------------------------------------------------
# Accented vowels (including breathing + accent combinations): acute and circumflex become ˈ immediately before
# the accented vowel nucleus. Syllable-onset placement is a later stage.
# ----------------------------------------------------------------------
class,a-acute,[άἄἅ],,,,
class,a-circ,[ᾶἇ],,,,
class,e-acute,[έἔἕ],,,,
class,eː-acute,[ήἥ],,,,
class,eː-circ,[ῆἦ],,,,
class,i-acute,[ίἵ],,,,
class,i-circ,[ῖἷ],,,,
class,y-acute,[ύὕ],,,,
class,y-circ,[ῦὗ],,,,
class,o-acute,[όὅ],,,,
class,oː-acute,[ώὥ],,,,
class,oː-circ,[ῶὦ],,,,

sub,{a-acute},ˈa,10,,,"acute alpha; mark accented nucleus"
sub,{a-circ},ˈaː,10,,,"circumflex alpha; mark accented nucleus"
sub,{e-acute},ˈɛ,10,,,"acute epsilon; mark accented nucleus"
sub,{eː-acute},ˈeː,10,,,"acute eta; mark accented nucleus"
sub,{eː-circ},ˈeː,10,,,"circumflex eta; mark accented nucleus"
sub,{i-acute},ˈi,10,,,"acute iota; mark accented nucleus"
sub,{i-circ},ˈiː,10,,,"circumflex iota; mark accented nucleus"
sub,{y-acute},ˈy,10,,,"acute upsilon; mark accented nucleus"
sub,{y-circ},ˈyː,10,,,"circumflex upsilon; mark accented nucleus"
sub,{o-acute},ˈo̞,10,,,"acute omicron; mark accented nucleus"
sub,{oː-acute},ˈo̞ː,10,,,"acute omega; mark accented nucleus"
sub,{oː-circ},ˈo̞ː,10,,,"circumflex omega; mark accented nucleus"

# ----------------------------------------------------------------------
# Breathing
# Smooth and rough breathing are both phonologically null.
# Pair the two spellings for each vowel to avoid parallel rules.
# ----------------------------------------------------------------------
class,breathing-a,[ἀἁ],,,,
class,breathing-e,[ἐἑ],,,,
class,breathing-eː,[ἠἡ],,,,
class,breathing-i,[ἰἱ],,,,
class,breathing-y,[ὐὑ],,,,
class,breathing-o,[ὀὁ],,,,
class,breathing-oː,[ὠὡ],,,,

sub,{breathing-a},a,9,,,"breathing is not pronounced"
sub,{breathing-e},ɛ,9,,,"breathing is not pronounced"
sub,{breathing-eː},eː,9,,,"breathing is not pronounced"
sub,{breathing-i},i,9,,,"breathing is not pronounced"
sub,{breathing-y},y,9,,,"breathing is not pronounced"
sub,{breathing-o},o̞,9,,,"breathing is not pronounced"
sub,{breathing-oː},o̞ː,9,,,"breathing is not pronounced"

# ----------------------------------------------------------------------
# Grave: phonologically null.
# ----------------------------------------------------------------------
sub,ὰ,a,10,,,"grave dropped"
sub,ὲ,ɛ,10,,,"grave dropped"
sub,ὴ,eː,10,,,"grave dropped"
sub,ὶ,i,10,,,"grave dropped"
sub,ὺ,y,10,,,"grave dropped"
sub,ὸ,o̞,10,,,"grave dropped"
sub,ὼ,o̞ː,10,,,"grave dropped"
sub,ᾲ,aː,10,,,"grave dropped"
sub,ῂ,eː,10,,,"grave dropped"
sub,ῲ,o̞ː,10,,,"grave dropped"

# ----------------------------------------------------------------------
# Consonants
# ----------------------------------------------------------------------
sub,{beta},β,2,,,"beta"
sub,{delta},d,2,,,"delta"
sub,{chi},kʰ,2,,,"chi default"
sub,{phi},pʰ,2,,,"phi"
sub,{theta},tʰ,2,,,"theta"
sub,{kappa},k,2,,,"kappa default"
sub,{pi},p,2,,,"pi"
sub,{tau},t,2,,,"tau"
sub,{mu},m,2,,,"mu"
sub,{nu},n,2,,,"nu"
sub,{lambda},l,2,,,"lambda"
sub,{rho},ɾ,2,,,"rho"
sub,{sigma},s̠,2,,,"sigma default"
sub,{zeta},z̠,2,,,"zeta"
sub,{psi},ps̠,2,,,"psi"
sub,{xi},ks̠,2,,,"xi"
sub,{gamma},ɣ,2,,,"gamma default"

# Context-sensitive consonants
sub,{gamma},ɟ,12,{nasal},{front},"gamma after nasal before front vowel"
sub,{gamma},ɲ,12,,{velar}{front},"gamma before palatalized velar"
sub,{gamma},ɡ,11,{nasal},,"gamma after nasal"
sub,{gamma},ŋ,11,,{velar},"gamma before velar"
sub,{gamma},ŋ,11,,μ,"gamma before mu"
sub,{gamma},ʝ,11,,ο[ιί],"gamma before oi"
sub,{gamma},ʝ,10,,{front},"gamma before front vowel"
sub,{beta},b,10,{nasal},,"beta after nasal"
sub,{chi},cʰ,10,,{front},"chi before front vowel"
sub,{kappa},c,10,,{front},"kappa before front vowel"
sub,{kappa},g,10,ἐκ,{voiced},"kappa in ἐκ- before voiced consonant"
sub,{sigma},z̠,10,,{voiced},"sigma before voiced consonant"

# ----------------------------------------------------------------------
# Diphthongs
#
# XPF's documented multigraph pattern: translate the first grapheme using
# the second as context, then delete the second grapheme with a cleanup rule.
# This is the same architecture used in the supplied Modern Greek rules.

class,i-digraph,[ιίῖ],,,,
class,u-digraph,[υύ],,,,
class,u-diphthong-member,[υὐὑύ],,,,

sub,ε,i,12,ζ,{i-digraph},"short ει in ἐγγίζειν"
sub,ε,ˈiː,12,,[ίῖ],"accented ei, including circumflex iota"
sub,ε,iː,8,,{i-digraph},"ei"
sub,{i-digraph},,11,ε,,"cleanup after ei; outranks acute-iota"

sub,ο,ˈyː,12,,[ί],"accented oi"
sub,ο,yː,8,,{i-digraph},"oi"
sub,{i-digraph},,14,ο,,"cleanup after oi; outranks standalone accented iota"

sub,α,ˈɛː,12,,[ίῖ],"accented ai"
sub,α,ɛː,8,,{i-digraph},"ai"
sub,{i-digraph},,14,α,,"cleanup after ai; outranks standalone accented iota"

sub,η,eː,8,,ι,"eta-iota"
sub,ι,,8,η,,"cleanup after eta-iota"

sub,υ,ˈy,12,,[ί],"accented upsilon-iota"
sub,υ,y,8,,ι,"upsilon-iota"
sub,ι,,14,υ,,"cleanup after upsilon-iota"

sub,ο,ˈu,12,,[ύ],"accented ou"
sub,ο,u,8,,υ,"ou"
sub,{u-digraph},,8,ο,,"cleanup after ou"

# αυ / ευ / ηυ
# Second-member acute accent in αυ / ευ / ηυ: retain it on the diphthong nucleus.
sub,α,ˈaɸ,13,,[ύ]{voiceless},"accented au before voiceless consonant"
sub,α,ˈaβ,13,,[ύ]{voiced},"accented au before voiced consonant"
sub,α,ˈaβ,13,,[ύ][αεηιουω],"accented au before vowel"
sub,α,ˈaɸ,13,,[ύ]$,"accented au final"
sub,ε,ˈɛɸ,13,,[ύ]{voiceless},"accented eu before voiceless consonant"
sub,ε,ˈɛβ,13,,[ύ]{voiced},"accented eu before voiced consonant"
sub,ε,ˈɛβ,13,,[ύ][αεηιουω],"accented eu before vowel"
sub,ε,ˈɛɸ,13,,[ύ]$,"accented eu final"
sub,η,ˈeːɸ,13,,[ύ]{voiceless},"accented eta-upsilon before voiceless consonant"
sub,η,ˈeːβ,13,,[ύ]{voiced},"accented eta-upsilon before voiced consonant"
sub,η,ˈeːβ,13,,[ύ][αεηιουω],"accented eta-upsilon before vowel"
sub,η,ˈeːɸ,13,,[ύ]$,"accented eta-upsilon final"

sub,α,aɸ,10,,{u-diphthong-member}{voiceless},"au before voiceless consonant"
sub,α,aβ,9,,{u-diphthong-member}{voiced},"au before voiced consonant"
sub,α,aβ,9,,{u-diphthong-member}[αεηιουω],"au before vowel"
sub,α,aɸ,10,,{u-diphthong-member}$,"au final"

sub,ε,ɛɸ,10,,{u-diphthong-member}{voiceless},"eu before voiceless consonant"
sub,ε,ɛβ,9,,{u-diphthong-member}{voiced},"eu before voiced consonant"
sub,ε,ɛβ,9,,{u-diphthong-member}[αεηιουω],"eu before vowel"
sub,ε,ɛɸ,10,,{u-diphthong-member}$,"eu final"

sub,η,eːɸ,10,,{u-diphthong-member}{voiceless},"eta-upsilon before voiceless consonant"
sub,η,eːβ,9,,{u-diphthong-member}{voiced},"eta-upsilon before voiced consonant"
sub,η,eːβ,9,,{u-diphthong-member}[αεηιουω],"eta-upsilon before vowel"
sub,η,eːɸ,10,,{u-diphthong-member}$,"eta-upsilon final"

# Cleanup of the second member of αυ / ευ / ηυ.
sub,{u-diphthong-member},,14,α,,"cleanup second member of αυ"
sub,{u-diphthong-member},,14,ε,,"cleanup second member of ευ"
sub,{u-diphthong-member},,14,η,,"cleanup second member of ηυ"

# Plain vowels
# ----------------------------------------------------------------------
sub,{i},i,2,,,
sub,{y},y,2,,,
sub,{eː},eː,2,,,
sub,{e},ɛ,2,,,"epsilon: open-mid front unrounded vowel"
sub,{a},a,2,,,
sub,ᾱ,aː,2,,,"long alpha"
sub,ᾳ,aː,2,,,"alpha with iota subscript"
sub,{o},o̞,2,,,
sub,{oː},o̞ː,2,,,
sub,ῳ,o̞ː,2,,,"omega with iota subscript"
sub,ῃ,eː,8,,,"eta with iota subscript"
sub,ηι,eː,8,,,"eta-iota"

# One test example, ἀγγαρεύω, has short final ω in the supplied expected output.
sub,{oː},o̞,14,ε{u-digraph},$,"ἀγγαρεύω: short final omega in this test form"

# ----------------------------------------------------------------------
# Further tests: palatalized velars and kappa before diphthongs
# ----------------------------------------------------------------------

# κ is palatalized before οι and αι as well as before single front vowels.
# The first member of these diphthongs (ο / α) is not itself a front vowel,
# so the ordinary {front} lookahead cannot detect them.
sub,{kappa},c,11,,ο{i-digraph},"kappa before οι"
sub,{kappa},c,11,,α{i-digraph},"kappa before αι"

# οι is position-independent: the general oi rule above applies everywhere.

# Collapse the written double sigma in κηρύσσω to a single /s̠/, as expected
# by the current verification case.
sub,{sigma},,14,σ,,"collapse second sigma in σσ"
