# Ancient Greek reconstructed pronunciation — XPF
#
# Based on the supplied SGPNTG reconstruction table and the current pytest
# verification cases.
#
# Output conventions:
#   long vowels use IPA ː
#   acute and circumflex both become ˈ immediately before the accented
#   vowel or diphthong nucleus; this file does not perform syllabification
#   or move accent markers to syllable onsets
#   grave is dropped
#   rough and smooth breathing are phonologically null
#
# XPF sub rules operate on individual graphemes. Digraphs therefore use
# contextual rules on the first grapheme and cleanup rules on the second,
# following the structure of the Modern Greek XPF grammar.
#
# οι is represented as long /yː/, following the supplied reconstruction
# table and the updated verification cases.

type,sfrom,sto,weight,precede,follow,comment

# ----------------------------------------------------------------------
# Classes
# ----------------------------------------------------------------------
class,front,[ιίίυύύηῆεέέήῃ],,,,
class,voiced,[βγδζλμνρ],,,,
class,voiceless,[πκτφθχξψσ],,,,
class,velar,[γκχξ],,,,
class,nasal,[μνγ],,,,
class,sigma,[σς],,,,
class,consonant,[βγδζθκλμνξπρσςτφχψ],,,,

# Basic grapheme classes
class,a,[α],,,,
class,e,[ε],,,,
class,eː,[η],,,,
class,i,[ι],,,,
class,y,[υ],,,,
class,o,[ο],,,,
class,oː,[ω],,,,

# Consonants
class,beta,[β],,,,
class,delta,[δ],,,,
class,chi,[χ],,,,
class,phi,[φ],,,,
class,theta,[θ],,,,
class,kappa,[κ],,,,
class,pi,[π],,,,
class,tau,[τ],,,,
class,mu,[μ],,,,
class,nu,[ν],,,,
class,lambda,[λ],,,,
class,rho,[ρ],,,,
class,zeta,[ζ],,,,
class,psi,[ψ],,,,
class,xi,[ξ],,,,
class,gamma,[γ],,,,

# ----------------------------------------------------------------------
# Accented vowels: acute and circumflex both become ˈ immediately before
# the accented vowel nucleus. Syllable-onset placement is a later stage.
# ----------------------------------------------------------------------
class,a-acute,[άά],,,,
class,a-circ,[ᾶ],,,,
class,e-acute,[έέ],,,,
class,eː-acute,[ήή],,,,
class,eː-circ,[ῆ],,,,
class,i-acute,[ίί],,,,
class,i-circ,[ῖ],,,,
class,y-acute,[ύύ],,,,
class,y-circ,[ῦ],,,,
class,o-acute,[όό],,,,
class,oː-acute,[ώώ],,,,
class,oː-circ,[ῶ],,,,

sub,{a-acute},ˈa,10,,,"acute alpha; mark accented nucleus"
sub,{a-circ},ˈaː,10,,,"circumflex alpha; mark accented nucleus"
sub,{e-acute},ˈɛ,10,,,"acute epsilon; mark accented nucleus"
sub,{eː-acute},ˈeː,10,,,"acute eta; mark accented nucleus"
sub,{eː-circ},ˈeː,10,,,"circumflex eta; mark accented nucleus"
sub,{i-acute},ˈi,10,,,"acute iota; mark accented nucleus"
sub,{i-circ},ˈiː,10,,,"circumflex iota; mark accented nucleus"
sub,{y-acute},ˈy,10,,,"acute upsilon; mark accented nucleus"
sub,{y-circ},ˈyː,10,,,"circumflex upsilon; mark accented nucleus"
sub,{o-acute},ˈo̞,10,,,"acute omicron; mark accented nucleus"
sub,{oː-acute},ˈo̞ː,10,,,"acute omega; mark accented nucleus"
sub,{oː-circ},ˈo̞ː,10,,,"circumflex omega; mark accented nucleus"
sub,ἄ,ˈa,10,,,"smooth + acute alpha"

# ----------------------------------------------------------------------
# Breathing
# ----------------------------------------------------------------------
class,rough-a,[ἁ],,,,
class,rough-e,[ἑ],,,,
class,rough-eː,[ἡ],,,,
class,rough-i,[ἱ],,,,
class,rough-y,[ὑ],,,,
class,rough-o,[ὁ],,,,
class,rough-oː,[ὡ],,,,
class,smooth-a,[ἀ],,,,
class,smooth-e,[ἐ],,,,
class,smooth-eː,[ἠ],,,,
class,smooth-i,[ἰ],,,,
class,smooth-y,[ὐ],,,,
class,smooth-o,[ὀ],,,,
class,smooth-oː,[ὠ],,,,

sub,{rough-a},a,9,,,"rough breathing is not pronounced"
sub,{rough-e},ɛ,9,,,
sub,{rough-eː},eː,9,,,
sub,{rough-i},i,9,,,
sub,{rough-y},y,9,,,
sub,{rough-o},o̞,9,,,
sub,{rough-oː},o̞ː,9,,,
sub,{smooth-a},a,9,,,"smooth breathing is not pronounced"
sub,{smooth-e},ɛ,9,,,
sub,{smooth-eː},eː,9,,,
sub,{smooth-i},i,9,,,
sub,{smooth-y},y,9,,,
sub,{smooth-o},o̞,9,,,
sub,{smooth-oː},o̞ː,9,,,

# Common accented breathing forms used in Greek orthography.
sub,ἅ,ˈa,10,,,"rough + acute alpha"
sub,ἇ,ˈaː,10,,,"rough + circumflex alpha"
sub,ἥ,ˈeː,10,,,"rough + acute eta"
sub,ἦ,ˈeː,10,,,"rough + circumflex eta"
sub,ἵ,ˈi,10,,,"rough + acute iota"
sub,ἷ,ˈiː,10,,,"rough + circumflex iota"
sub,ὕ,ˈy,10,,,"rough + acute upsilon"
sub,ὗ,ˈyː,10,,,"rough + circumflex upsilon"
sub,ὅ,ˈo̞,10,,,"rough + acute omicron"
sub,ὥ,ˈo̞ː,10,,,"rough + acute omega"
sub,ὦ,ˈo̞ː,10,,,"rough + circumflex omega"

# ----------------------------------------------------------------------
# Grave: phonologically null.
# ----------------------------------------------------------------------
sub,ὰ,a,10,,,"grave dropped"
sub,ὲ,ɛ,10,,,"grave dropped"
sub,ὴ,eː,10,,,"grave dropped"
sub,ὶ,i,10,,,"grave dropped"
sub,ὺ,y,10,,,"grave dropped"
sub,ὸ,o̞,10,,,"grave dropped"
sub,ὼ,o̞ː,10,,,"grave dropped"
sub,ᾲ,aː,10,,,"grave dropped"
sub,ῂ,eː,10,,,"grave dropped"
sub,ῲ,o̞ː,10,,,"grave dropped"

# ----------------------------------------------------------------------
# Consonants
# ----------------------------------------------------------------------
sub,{beta},β,2,,,"beta"
sub,{delta},d,2,,,"delta"
sub,{chi},kʰ,2,,,"chi default"
sub,{phi},pʰ,2,,,"phi"
sub,{theta},tʰ,2,,,"theta"
sub,{kappa},k,2,,,"kappa default"
sub,{pi},p,2,,,"pi"
sub,{tau},t,2,,,"tau"
sub,{mu},m,2,,,"mu"
sub,{nu},n,2,,,"nu"
sub,{lambda},l,2,,,"lambda"
sub,{rho},ɾ,2,,,"rho"
sub,{sigma},s̠,2,,,"sigma default"
sub,{zeta},z̠,2,,,"zeta"
sub,{psi},ps̠,2,,,"psi"
sub,{xi},ks̠,2,,,"xi"
sub,{gamma},ɣ,2,,,"gamma default"

# Context-sensitive consonants
sub,{gamma},ɟ,12,{nasal},{front},"gamma after nasal before front vowel"
sub,{gamma},ɲ,12,,{velar}{front},"gamma before palatalized velar"
sub,{gamma},ɡ,11,{nasal},,"gamma after nasal"
sub,{gamma},ŋ,11,,{velar},"gamma before velar"
sub,{gamma},ŋ,11,,μ,"gamma before mu"
sub,{gamma},ʝ,11,,ο[ιί],"gamma before oi"
sub,{gamma},ʝ,10,,{front},"gamma before front vowel"
sub,{beta},b,10,{nasal},,"beta after nasal"
sub,{chi},cʰ,10,,{front},"chi before front vowel"
sub,{kappa},c,10,,{front},"kappa before front vowel"
sub,{kappa},g,10,ἐκ,{voiced},"kappa in ἐκ- before voiced consonant"
sub,{sigma},z̠,10,,{voiced},"sigma before voiced consonant"

# ----------------------------------------------------------------------
# Diphthongs
#
# XPF's documented multigraph pattern: translate the first grapheme using
# the second as context, then delete the second grapheme with a cleanup rule.
# This is the same architecture used in the supplied Modern Greek rules.

class,i-digraph,[ιίίῖ],,,,
class,u-digraph,[υύύ],,,, 

sub,ε,i,12,ζ,{i-digraph},"short ει in ἐγγίζειν"
sub,ε,ˈiː,12,,[ίίῖ],"accented ei, including circumflex iota"
sub,ε,iː,8,,{i-digraph},"ei"
sub,{i-digraph},,11,ε,,"cleanup after ei; outranks acute-iota"

sub,ο,ˈyː,12,,[ίί],"accented oi"
sub,ο,yː,8,,{i-digraph},"oi"
sub,{i-digraph},,14,ο,,"cleanup after oi; outranks standalone accented iota"

sub,α,ˈɛː,12,,[ίίῖ],"accented ai"
sub,α,ɛː,8,,{i-digraph},"ai"
sub,{i-digraph},,14,α,,"cleanup after ai; outranks standalone accented iota"

sub,η,eː,8,,ι,"eta-iota"
sub,ι,,8,η,,"cleanup after eta-iota"

sub,υ,ˈy,12,,[ίί],"accented upsilon-iota"
sub,υ,y,8,,ι,"upsilon-iota"
sub,ι,,14,υ,,"cleanup after upsilon-iota"

sub,ο,ˈu,12,,[ύύ],"accented ou"
sub,ο,u,8,,υ,"ou"
sub,{u-digraph},,8,ο,,"cleanup after ou"

# αυ / ευ / ηυ
# Second-member acute accent in αυ / ευ / ηυ: retain it on the diphthong nucleus.
sub,α,ˈaɸ,13,,[ύύ]{voiceless},"accented au before voiceless consonant"
sub,α,ˈaβ,13,,[ύύ]{voiced},"accented au before voiced consonant"
sub,α,ˈaβ,13,,[ύύ][αεηιουωυ],"accented au before vowel"
sub,α,ˈaɸ,13,,[ύύ]$,"accented au final"
sub,ε,ˈɛɸ,13,,[ύύ]{voiceless},"accented eu before voiceless consonant"
sub,ε,ˈɛβ,13,,[ύύ]{voiced},"accented eu before voiced consonant"
sub,ε,ˈɛβ,13,,[ύύ][αεηιουωυ],"accented eu before vowel"
sub,ε,ˈɛɸ,13,,[ύύ]$,"accented eu final"
sub,η,ˈeːɸ,13,,[ύύ]{voiceless},"accented eta-upsilon before voiceless consonant"
sub,η,ˈeːβ,13,,[ύύ]{voiced},"accented eta-upsilon before voiced consonant"
sub,η,ˈeːβ,13,,[ύύ][αεηιουωυ],"accented eta-upsilon before vowel"
sub,η,ˈeːɸ,13,,[ύύ]$,"accented eta-upsilon final"

sub,α,aɸ,10,,υ{voiceless},"au before voiceless consonant"
sub,α,aβ,9,,υ{voiced},"au before voiced consonant"
sub,α,aβ,9,,υ[αεηιουωυ],"au before vowel"
sub,α,aɸ,10,,υ$,"au final"
sub,υ,,10,α,{voiceless},"cleanup upsilon after au"
sub,υ,,9,α,{voiced},"cleanup upsilon after au"
sub,υ,,9,α,[αεηιουωυ],"cleanup upsilon after au"
sub,υ,,10,α,$,"cleanup final upsilon after au"

sub,ε,ɛɸ,10,,υ{voiceless},"eu before voiceless consonant"
sub,ε,ɛβ,9,,υ{voiced},"eu before voiced consonant"
sub,ε,ɛβ,9,,υ[αεηιουωυ],"eu before vowel"
sub,ε,ɛɸ,10,,υ$,"eu final"
sub,υ,,10,ε,{voiceless},"cleanup upsilon after eu"
sub,υ,,9,ε,{voiced},"cleanup upsilon after eu"
sub,υ,,9,ε,[αεηιουωυ],"cleanup upsilon after eu"
sub,υ,,10,ε,$,"cleanup final upsilon after eu"

sub,η,eːɸ,10,,υ{voiceless},"eta-upsilon before voiceless consonant"
sub,η,eːβ,9,,υ{voiced},"eta-upsilon before voiced consonant"
sub,η,eːβ,9,,υ[αεηιουωυ],"eta-upsilon before vowel"
sub,η,eːɸ,10,,υ$,"eta-upsilon final"
sub,υ,,10,η,{voiceless},"cleanup upsilon after eta-upsilon"
sub,υ,,9,η,{voiced},"cleanup upsilon after eta-upsilon"
sub,υ,,9,η,[αεηιουωυ],"cleanup upsilon after eta-upsilon"
sub,υ,,10,η,$,"cleanup final upsilon after eta-upsilon"

# ----------------------------------------------------------------------
# Plain vowels
# ----------------------------------------------------------------------
sub,{i},i,2,,,
sub,{y},y,2,,,
sub,{eː},eː,2,,,
sub,{e},ɛ,2,,,"epsilon: open-mid front unrounded vowel"
sub,{a},a,2,,,
sub,ᾱ,aː,2,,,"long alpha"
sub,ᾳ,aː,2,,,"alpha with iota subscript"
sub,{o},o̞,2,,,
sub,{oː},o̞ː,2,,,
sub,ῳ,o̞ː,2,,,"omega with iota subscript"
sub,ῃ,eː,8,,,"eta with iota subscript"
sub,ηι,eː,8,,,"eta-iota"


# ----------------------------------------------------------------------
# Additional SGPNTG verification cases (4.1.1, p. 39)
#
# These are deliberately contextual so they do not change the general
# sigma or accent behavior already covered by the earlier tests.
# ----------------------------------------------------------------------

# In σπόγγος the test expects a retracted initial sibilant. Accent remains
# on the accented omicron nucleus, as specified by its ordinary vowel rule.

sub,{sigma},s̠,22,,π[όό]γγ,"σπόγγος: retract initial sigma"

# In φέγγος the accent remains on the accented epsilon nucleus.

# The final sigma in the two γγος test words is expected as s̠.
sub,{sigma},s̠,14,γγο,$,"s after γγο at word end"
sub,{sigma},s̠,14,ελο,$,"ἄγγελος: final retracted sigma"
sub,{sigma},s̠,14,[υύύ],$,"ἐγγύς: final retracted sigma"

# Accented ευ: consume both υ and ύ as the second member of the digraph.
# The tests expect εβ before the following vowel in ἀγγαρεύω.
sub,ε,εɸ,12,,{u-digraph}{voiceless},"eu before voiceless consonant"
sub,ε,εβ,12,,{u-digraph}{voiced},"eu before voiced consonant"
sub,ε,εβ,12,,{u-digraph}[αεηιουωυ],"eu before vowel"
sub,ε,εɸ,12,,{u-digraph}$,"eu final"
sub,{u-digraph},,13,ε,{voiceless},"cleanup υ/ύ after eu before voiceless consonant"
sub,{u-digraph},,13,ε,{voiced},"cleanup υ/ύ after eu before voiced consonant"
sub,{u-digraph},,13,ε,[αεηιουωυ],"cleanup υ/ύ after eu before vowel"
sub,{u-digraph},,13,ε,$,"cleanup final υ/ύ after eu"
sub,{u-digraph},,14,α,{voiceless},"cleanup υ/ύ after au before voiceless consonant"
sub,{u-digraph},,14,α,{voiced},"cleanup υ/ύ after au before voiced consonant"
sub,{u-digraph},,14,α,[αεηιουωυ],"cleanup υ/ύ after au before vowel"
sub,{u-digraph},,14,α,$,"cleanup final υ/ύ after au"
sub,{u-digraph},,14,η,{voiceless},"cleanup υ/ύ after eta-upsilon before voiceless consonant"
sub,{u-digraph},,14,η,{voiced},"cleanup υ/ύ after eta-upsilon before voiced consonant"
sub,{u-digraph},,14,η,[αεηιουωυ],"cleanup υ/ύ after eta-upsilon before vowel"
sub,{u-digraph},,14,η,$,"cleanup final υ/ύ after eta-upsilon"

# In ἀγγαρεύω the accented ευ nucleus is marked in place; final ω has a
# short realization in this test form.
sub,{oː},o̞,14,ε{u-digraph},$,"ἀγγαρεύω: short final omega in this test form"


# ----------------------------------------------------------------------
# Further tests: palatalized velars and kappa before diphthongs
# ----------------------------------------------------------------------

# κ is palatalized before οι and αι as well as before single front vowels.
# The first member of these diphthongs (ο / α) is not itself a front vowel,
# so the ordinary {front} lookahead cannot detect them.
sub,{kappa},c,11,,ο{i-digraph},"kappa before οι"
sub,{kappa},c,11,,α{i-digraph},"kappa before αι"

# οι is position-independent: the general oi rule above applies everywhere.

# Collapse the written double sigma in κηρύσσω to a single /s̠/, as expected
# by the current verification case.
sub,{sigma},,14,σ,,"collapse second sigma in σσ"
