# Accent output
# ----------------------------------------------------------------------

sub,{a-acute},ˈa,10,,,"acute alpha"
sub,{a-circ},ˈaː,10,,,"circumflex alpha"
sub,{e-acute},ˈe,10,,,"acute epsilon"
sub,{eː-acute},ˈeː,10,,,"acute eta"
sub,{eː-circ},ˈeː,10,,,"circumflex eta"
