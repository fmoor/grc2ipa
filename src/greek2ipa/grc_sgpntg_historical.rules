# Consonants
# ----------------------------------------------------------------------

sub,{beta},β,2,,,"beta"
sub,{delta},d,2,,,"delta"
sub,{chi},kʰ,2,,,"chi default"
sub,{phi},pʰ,2,,,"phi"
sub,{theta},tʰ,2,,,"theta"
sub,{kappa},k,2,,,"kappa default"
sub,{pi},p,2,,,"pi"
sub,{tau},t,2,,,"tau"
sub,{mu},m,2,,,"mu"
sub,{nu},n,2,,,"nu"
sub,{lambda},l,2,,,"lambda"
sub,{rho},ɾ,2,,,"rho"
sub,{sigma},s̠,2,,,"sigma default"
sub,{zeta},z̠,2,,,"zeta"
sub,{psi},ps̠,2,,,"psi"
sub,{xi},ks̠,2,,,"xi"
sub,{gamma},ɣ,2,,,"gamma default"

# ----------------------------------------------------------------------
# Context-sensitive consonants
# Higher weights override defaults.
# ----------------------------------------------------------------------

# gamma
sub,{gamma},ʝ,10,,{front},"gamma before front vowel"
sub,{gamma},ɡ,10,{nasal},,"gamma after nasal"
sub,{gamma},ɟ,11,{nasal},{front},"gamma after nasal before front vowel"
sub,{gamma},ŋ,11,,{velar},"gamma before velar"
sub,{gamma},ɲ,12,,{velar}{front},"gamma before palatalized velar"
sub,{gamma},ŋ,11,,μ,"gamma before mu"

# beta
sub,{beta},b,10,{nasal},,"beta after nasal"

# chi
sub,{chi},cʰ,10,,{front},"chi before front vowel"

# kappa
sub,{kappa},c,10,,{front},"kappa before front vowel"
sub,{kappa},g,10,ἐκ,{voiced},"kappa in ἐκ- before voiced consonant"

# sigma
sub,{sigma},z̠,10,,{voiced},"sigma before voiced consonant"

# ----------------------------------------------------------------------
# Diphthongs
#
# XPF's normal pattern is to convert the first element to an intermediate
# marker and then delete the second element. This section follows that
# architecture.
# ----------------------------------------------------------------------

sub,α,AU,8,,υ,"au marker"
sub,υ,,8,AU,,"delete upsilon after au marker"
sub,ε,EU,8,,υ,"eu marker"
sub,υ,,8,EU,,"delete upsilon after eu marker"
sub,η,EUH,8,,υ,"eta-upsilon marker"
sub,υ,,8,EUH,,"delete upsilon after eta-upsilon marker"
sub,υ,UI,8,,ι,"ui marker"
sub,ι,,8,UI,,"delete iota after ui marker"
sub,ε,EI,8,,ι,"ei marker"
sub,ι,,8,EI,,"delete iota after ei marker"
sub,ο,OI,8,,ι,"oi marker"
sub,ι,,8,OI,,"delete iota after oi marker"
sub,α,AI,8,,ι,"ai marker"
sub,ι,,8,AI,,"delete iota after ai marker"
sub,ο,OU,8,,υ,"ou marker"
sub,υ,,8,OU,,"delete upsilon after ou marker"

# Diphthong outputs
sub,AU,aβ,7,,,"au default"
sub,EU,eβ,7,,,"eu default"
sub,EUH,eːβ,7,,,"eta-upsilon default"
sub,UI,y,7,,,"ui"
sub,EI,iː,7,,,"ei"
sub,OI,yː,7,,,"oi"
sub,AI,eː,7,,,"ai"
sub,OU,u,7,,,"ou"

# Voiceless/final αυ ευ ηυ
sub,AU,aɸ,9,,{voiceless},"au before voiceless consonant"
sub,EU,eɸ,9,,{voiceless},"eu before voiceless consonant"
sub,EUH,eːɸ,9,,{voiceless},"eta-upsilon before voiceless consonant"

